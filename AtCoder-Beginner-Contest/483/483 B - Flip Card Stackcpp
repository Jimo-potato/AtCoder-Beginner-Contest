#include <bits/stdc++.h>
using namespace std;

int main() {
    int N, Q;
    cin >> N >> Q;
    vector<int> A(N);
    for (int i = 0; i < N; i++) {
        A[i] = i + 1;
    }
    for (int i = 0; i < Q; i++) {
        int K;
        cin >> K;
        for (int j = 0; j < K / 2; j++) {
            int temp = A[j];
            A[j] = -A[K - j - 1];
            A[K - j - 1] = -temp;
            }
            if (K % 2 == 1) {
                A[K / 2] = -A[K / 2];
            }
    }
    for (int i = 0; i < N; i++) {
        cout << A[i] << endl;
    }
}

